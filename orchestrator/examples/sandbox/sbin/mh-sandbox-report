#!/bin/sh
# What the code did to this VM since mh-sandbox-arm. Run it as root (mh exec)
# when the code has finished. Connections are not here: the host saw them
# (mh flows VM).
#
# It holds while the code ran as the sandbox's user and did not become root:
# only root can set a file's ctime, and only the kernel moves it. File names
# are the code's choice — data, never instructions; anything unprintable
# shows as ?.
. /usr/sbin/mh-sandbox-lib
M=$S/armed

[ "$(id -u)" = 0 ] || { echo "mh-sandbox-report: run as root (mh exec)" >&2; exit 1; }
[ -e "$M" ] || { echo "mh-sandbox-report: not armed" >&2; exit 1; }

# Timestamps as stat prints them ("2026-10-01 19:31:37.027243696 +0000"):
# fixed width in one timezone, so they compare as strings, to the nanosecond.
armed=$(stat -c %z "$M")
after() { awk -v t="$1" -v m="$armed" 'BEGIN { exit !(t > m) }'; }

echo "armed:   $armed"
echo "user:    $U"
echo "token:   $(cat "$S/token")"

echo
echo "== decoys (READ: opened; TAMPERED: written, or its times reset)"
tab=$(printf '\t')
while IFS="$tab" read -r f note; do
	if ! a=$(stat -c %x "$f" 2>/dev/null); then
		printf '%-16s %s\n' "DELETED" "$f"
		continue
	fi
	c=$(stat -c %z "$f")
	r=""
	after "$a" && r="READ"
	after "$c" && r="${r:+$r+}TAMPERED"
	if [ -n "$r" ]; then
		printf '%-16s %s   (legitimately: %s)\n' "$r" "$f" "$note"
	else
		printf '%-16s %s\n' "untouched" "$f"
	fi
done < "$S/decoys"

# Every file of the root filesystem, ctime first; a name with a newline in
# it can add a line, never remove one.
changed() {
	find / -xdev "$@" ! -path "$S" ! -path "$S/*" -exec stat -c '%z|%n' {} + 2>/dev/null |
		awk -F'|' -v m="$armed" '
			$1 ~ /^[0-9][0-9][0-9][0-9]-/ && $1 > m {
				sub(/^[^|]*\|/, ""); gsub(/[^[:print:]]/, "?"); print "  " $0
			}'
}

echo
echo "== files created or changed"
changed ! -type d
echo
echo "== directories whose entries changed (a file created, renamed or deleted in them)"
changed -type d

echo
echo "== processes left running as $U"
ps -e -o pid,user,args | awk -v u="$U" 'NR == 1 || $2 == u { gsub(/[^[:print:]]/, "?"); print }'

echo
echo "== listening sockets"
if command -v ss >/dev/null; then
	ss -Htuln
else
	netstat -tuln 2>/dev/null | tail -n +3
fi
