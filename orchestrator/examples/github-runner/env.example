# Copy to .env (git ignores it), make it yours alone, and fill it in:
#   cp env.example .env && chmod 600 .env

# Where the runners register: OWNER/REPO, or an organization's name.
GITHUB_SCOPE=owner/repo

# The host interface that reaches the internet: ip route get 1.1.1.1
EGRESS_IFACE=eth0

# Custom labels, comma-separated; a workflow selects them with
# runs-on: [self-hosted, microhosted]
RUNNER_LABELS=microhosted

# The fine-grained token jit-config.py mints each VM's registration with
# (repository permission "Administration: Read and write"). Read only by
# jit-config.py, which refuses it unless this file is chmod 600; it never
# reaches a VM.
GITHUB_TOKEN=github_pat_...
