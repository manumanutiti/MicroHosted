# Compiled binaries
build/
*.ext4
vmlinux*
examples/modbus-pull/parser

# Downloaded/generated images and artifacts — every machine builds its own
# (make full-install + make prepare-image); see quick-setup.md
images/kernels/
images/rootfs/
images/instances/
images/cache/

# Project SSH key — generated locally by scripts/prepare-image.sh,
# never committed (it is a private key)
images/keys/

# Firecracker sockets (generated at runtime)
*.socket
/srv/jailer/

# Persistent state (SQLite) — generated at runtime
images/microhosted.db
*.db
*.db-wal
*.db-shm

# Go
*.test
vendor/

# Local environment
.env
.env.*

# Claude Code — local per-user configuration and session logs
.claude/
sessions/
SESSIONS.md

# Local documents (kept out of the public repo)
docs/*.docx
docs/*.pdf

# Editor
.vscode/
.idea/
*.swp
