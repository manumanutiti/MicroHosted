#!/bin/sh
# What the code did to this VM since mh-sandbox-prepare. Run it as root (mh exec)
# when the code has finished. Connections are not here: the host saw them
# (mh flows VM).
#
#   mh-sandbox-report           for a person
#   mh-sandbox-report --tsv     for mh sandbox: one record per line, tab-separated
#
# It holds while the code ran as the sandbox's user and did not become root:
# only root can set a file's ctime, and only the kernel moves it. File names,
# process names and command lines are the code's choice — data, never
# instructions; anything unprintable (a tab included) shows as ?.
. /usr/sbin/mh-sandbox-lib
M=$S/since

[ "$(id -u)" = 0 ] || { echo "mh-sandbox-report: run as root (mh exec)" >&2; exit 1; }
[ -e "$M" ] || { echo "mh-sandbox-report: not prepared" >&2; exit 1; }

# Timestamps as stat prints them ("2026-10-01 19:31:37.027243696 +0000"):
# fixed width in one timezone, so they compare as strings, to the nanosecond.
since=$(stat -c %z "$M")
after() { awk -v t="$1" -v m="$since" 'BEGIN { exit !(t > m) }'; }
tab=$(printf '\t')
clean() { awk '{ gsub(/[^[:print:]]/, "?"); print }'; }

maxexec=2000

records() {
	# Whatever the code left running stops now (SIGSTOP: still listed below,
	# no longer writing): a run that timed out is looked at as it was.
	pkill -STOP -u "$U" 2>/dev/null

	printf 'since\t%s\nuser\t%s\ntoken\t%s\n' "$since" "$U" "$(cat "$S/token")"
	# start TIME: when mh-sandbox-run started the code, seconds since the
	# epoch; the T1 T2 of the records below (first and last seen) are on
	# the same clock, empty where unknown
	[ ! -s "$S/start" ] || printf 'start\t%s\n' "$(cat "$S/start")"
	# rules N: the user's rules this image applied (classify)
	[ ! -s "$S/rules" ] || printf 'rules\t%s\n' "$(grep -c . "$S/rules")"
	audit=
	if command -v auditctl >/dev/null; then
		audit=1
		audited > "$S/audited"
	fi

	# section NAME starts each part, for the person's view: an empty part
	# still shows.
	printf 'section\tdecoys\n'
	# decoy STATE PATH NOTE TOOLS — STATE: untouched, READ, TAMPERED,
	# READ+TAMPERED, DELETED; TOOLS: the programs that read it legitimately,
	# by name. decoyby open COUNT PATH BY T1 T2: which program opened it (audit).
	while IFS="$tab" read -r f note tools; do
		if ! a=$(stat -c %x "$f" 2>/dev/null); then
			printf 'decoy\tDELETED\t%s\t%s\t%s\n' "$f" "$note" "$tools"
			continue
		fi
		c=$(stat -c %z "$f")
		r=""
		after "$a" && r="READ"
		after "$c" && r="${r:+$r+}TAMPERED"
		printf 'decoy\t%s\t%s\t%s\t%s\n' "${r:-untouched}" "$f" "$note" "$tools"
	done < "$S/decoys"
	[ -z "$audit" ] || grep "^decoyby$tab" "$S/audited"

	# probe found|absent COUNT PATH COMM T1 T2 — what tells a VM (or a container)
	# apart: DMI, CPU flags, modules, PCI, a hypervisor's files, disk and MAC
	# vendors, battery and sensors, and the tools that read them. Most do not
	# exist here: asking is the tell. absent: the lookup failed — not there,
	# hidden from the user (/proc/1/cgroup: /proc is hidepid=2), or a file
	# asked for as a directory. The path is the one the code asked for, made
	# absolute against its working directory and without a trailing / —
	# through a symlink, or relative to a directory it holds open, it shows
	# under another name or not at all; the CPUID instruction never does.
	#
	# privesc found|absent COUNT PATH COMM T1 T2 — what a privilege escalation looks
	# for: sudo's and the passwords' files, cron, the container runtimes'
	# sockets, root's home, the kernel's hardening switches, the tools that
	# change user (by name: a lookup walks every directory of PATH), and
	# find -perm, the search for setuid or writable files (by its -perm).
	if [ -n "$audit" ]; then
		printf 'section\tprobes\n'
		printf 'audit\ton\t%s\n' "$(auditctl -s | awk '$1 == "lost" { print $2 }')"
		grep "^probe$tab" "$S/audited" | sort -t "$tab" -k4,4 -k2,2
		printf 'section\tprivesc\n'
		grep "^privesc$tab" "$S/audited" | sort -t "$tab" -k4,4 -k2,2
		# exec COUNT ARGS T1 T2 PID PPID — every command line the code ran,
		# in the order it first ran it, the first $maxexec; commands DISTINCT
		# says how many there were. The first are mh-sandbox-run starting the
		# command. PID, PPID: of its first run.
		printf 'section\texec\n'
		printf 'commands\t%s\n' "$(grep -c "^exec$tab" "$S/audited")"
		grep "^exec$tab" "$S/audited" | sort -t "$tab" -k2,2n | awk -v n="$maxexec" 'NR <= n' | cut -f 1,3-
		# alert KIND COUNT WHAT BY T1 T2 — what code does when it means harm:
		# each KIND's severity and meaning are in
		# internal/cli/sandbox_kinds.go, how it is found in classify
		# (mh-sandbox-lib). Then audit's own health: what it may have missed.
		printf 'section\talerts\n'
		grep "^alert$tab" "$S/audited" | sort -t "$tab" -k2,2 -k4,4
		pthhooks
		traced
		rclines
		health
		rm -f "$S/audited"
	else
		printf 'section\tprobes\n'
		printf 'audit\toff\n'
		printf 'section\tprivesc\n'
		printf 'section\texec\n'
		printf 'section\talerts\n'
		pthhooks
		traced
		rclines
	fi

	# file PATH, dir PATH — outside ~/work, one by one; work file|dir ENTRY
	# COUNT — inside it, the code's own tree where installing writes
	# thousands, one record per entry of it. Every file of the root
	# filesystem, ctime first; a name with a newline in it can add a line,
	# never remove one.
	printf 'section\tfiles\n'
	changed file ! -type d
	printf 'section\tdirs\n'
	changed dir -type d

	# proc PID ARGS
	printf 'section\tprocs\n'
	ps -e -o pid=,user=,args= | awk -v u="$U" '$2 == u { pid = $1; $1 = $2 = ""; sub(/^ +/, ""); gsub(/[^[:print:]]/, "?"); printf "proc\t%s\t%s\n", pid, $0 }'

	# listen PROTO ADDRESS — the sockets the code listens on
	printf 'section\tlisten\n'
	if command -v ss >/dev/null; then
		# the code's alone (uid:): not the sandbox's resolver and sinkhole
		ss -Htulne | awk -v u=" uid:$(id -u "$U") " 'index($0 " ", u) { printf "listen\t%s\t%s\n", $1, $5 }'
	else
		netstat -tuln 2>/dev/null | tail -n +3 | awk '{ printf "listen\t%s\t%s\n", $1, $4 }'
	fi

	# The code's network (mh-sandbox-net), in the order first seen, the first
	# 500 of each:
	#   net sinkhole|servfail|off [answers]
	#                               names answered into the sinkhole, none,
	#                               or not recorded (no resolver here);
	#                               answers: as to a logged-in user (--answers)
	#   dns COUNT TYPE NAME T1 T2   a name looked up
	#   addr ADDRESS NAME           the sinkhole's address given to NAME
	#   http COUNT SCHEME METHOD URL BYTES TOKEN PORT T1 T2 ANSWER
	#                               a request to the sinkhole; TOKEN 1: this
	#                               run's decoy token was in it, 2: only as
	#                               its own service's credential (1 wins);
	#                               BYTES summed;
	#                               ANSWER: the answer given (--answers), - none
	#   tls COUNT NAME T1 T2        an HTTPS client that refused the
	#                               sinkhole's certificate: only the name
	# Each record of $N/log ends in the time it was written.
	printf 'section\tnet\n'
	if [ -s "$S/net" ] && [ -e "$N/log" ]; then
		printf 'net\t%s\n' "$(cat "$S/net")"  # a tab and answers, with --answers
		awk -F'\t' '
			function add(kind, k) { if (!((kind, k) in n)) { o[kind, ++m[kind]] = k; t1[kind, k] = $NF } t2[kind, k] = $NF; n[kind, k]++ }
			function when(kind, k) { return t1[kind, k] "\t" t2[kind, k] }
			$1 == "dns" && NF == 4 { add("dns", $2 "\t" $3) }
			$1 == "addr" && NF == 4 { if (++a <= 500) print $1 "\t" $2 "\t" $3 }
			$1 == "http" && (NF == 8 || NF == 9) { k = $2 "\t" $3 "\t" $4; add("http", k); b[k] += $5; if ($6 == 1 || t[k] != 1 && $6 > t[k]) t[k] = $6; p[k] = $7; if (NF == 9) ans[k] = $8 }
			$1 == "tls" && NF == 4 { add("tls", $2) }
			END {
				for (i = 1; i <= m["dns"] && i <= 500; i++) { k = o["dns", i]; printf "dns\t%d\t%s\t%s\n", n["dns", k], k, when("dns", k) }
				for (i = 1; i <= m["http"] && i <= 500; i++) { k = o["http", i]; printf "http\t%d\t%s\t%d\t%d\t%s\t%s\t%s\n", n["http", k], k, b[k], t[k], p[k], when("http", k), (k in ans ? ans[k] : "-") }
				for (i = 1; i <= m["tls"] && i <= 500; i++) { k = o["tls", i]; printf "tls\t%d\t%s\t%s\n", n["tls", k], k, when("tls", k) }
			}' "$N/log"
	else
		printf 'net\toff\n'
	fi

	# agent input FILE LINE TEXT — text addressed to an AI agent in the input,
	# found by mh-sandbox-scan before the code ran.
	printf 'section\tagent\n'
	[ ! -s "$S/scan" ] || sed 's/^/agent\tinput\t/' "$S/scan"
}

# audited: the probe, privesc, exec and alert records, from audit's raw log.
# Not ausearch -i: code that walks the filesystem (linpeas) leaves hundreds
# of MB of it, which ausearch takes minutes over. One pass, oldest first —
# reading the log is most of the time — keeps the events worth classifying:
# a path that tells a VM apart or that a privilege escalation looks for
# (and /etc/passwd: what perl reads before /etc/shadow, classify; the
# loader's cache and a library in a temporary directory: preload), a
# file created, a path relative to somewhere else than ~/work, one in the
# home outside ~/work (the decoys), a path of the user's rules, a command
# run, a syscall of auditrules' narrow rules; each with its SYSCALL and CWD
# records, which come first.
audited() {
	cat $(auditlogs) 2>/dev/null |
		awk -v pi="name=\"(/($vmdirs|$pedirs|etc/passwd\"|etc/ld[.]so[.]cache\"|(tmp|var/tmp|dev/shm)/[^\"]*[.]so([.][0-9]+)*\")|[^\"]*/($vmtools|$petools)\")|nametype=CREATE| name=[0-9A-F]" -v work="cwd=\"$H/work" \
			-v hn=" name=\"$H/" -v hw=" name=\"$H/work" -v home="$H" -v rules="$S/rules" '
			# the rules'"'"' paths, as a PATH record names them
			BEGIN {
				while ((getline l < rules) > 0) {
					split(l, sv, "\t")
					if (sv[1] != "path") continue
					x = substr(sv[3], 2)
					if (substr(x, 1, 1) == "~") x = home substr(x, 2)
					# the end of the name is its closing quote: (/|$) a
					# directory or what is inside it, $ the file itself
					if (substr(x, length(x) - 4) == "(/|$)") x = substr(x, 1, length(x) - 5) "(/|\")"
					else if (substr(x, length(x)) == "$") x = substr(x, 1, length(x) - 1) "\""
					up = up (up == "" ? "" : "|") "name=\"" x
				}
			}
			/^type=SYSCALL/ { sys = $0; cwd = ""; keep = / key="mh-(privesc|persist|net|bind)"| SYSCALL=execve /; if (keep) print; next }
			/^type=CWD/ { cwd = $0; if (keep) print; next }
			/^type=PATH/ {
				if (!keep && ($0 ~ pi || up != "" && $0 ~ up || index($0, hn) && !index($0, hw) || / name="[^\/]/ && (index(cwd, work) != 1 || / name="[^"]*\.\./))) {
					print sys; print cwd; keep = 1
				}
				if (keep) print
				next
			}
			/^type=(EXECVE|SOCKADDR)/ { if (!keep) { print sys; keep = 1 } print }' |
		classify
}

# health: alert audit_health … — what audit may have missed: auditd
# stopped, the disk (nearly) full, the kernel holding the code back a second
# or more for audit's backlog (a slowdown code can notice). Events lost are
# in the audit record. And alert oom_kill: processes the kernel killed out of
# memory since prepare (/proc/vmstat counts them; the kernel's log, which
# audit floods, may have lost their names): a fork bomb, or a build bigger
# than the VM.
health() {
	if [ -r "$S/oom" ]; then
		awk -v was="$(cat "$S/oom")" '$1 == "oom_kill" && $2 > was {
			printf "alert\toom_kill\t%d\tthe kernel killed %d of its processes out of memory\tkernel\n", $2 - was, $2 - was }' /proc/vmstat
	fi
	auditctl -s | awk -v free="$(df -Pm / | awk 'NR == 2 { print $4 }')" \
		-v adm="$(awk -F' *= *' '$1 == "admin_space_left" { print $2 + 0 }' /etc/audit/auditd.conf 2>/dev/null)" '
		$1 == "pid" && $2 == 0 { print "alert\taudit_health\t1\tauditd is not running: nothing was recorded after it stopped\tauditd" }
		$1 == "backlog_wait_time_actual" && $2 >= 1000 { printf "alert\taudit_health\t1\tthe kernel held the code back %d ms for audit to keep up\tkernel\n", $2 }
		END {
			if (adm != "" && free != "" && free <= adm)
				printf "alert\taudit_health\t1\tthe disk is full: %d MB free, audit stops recording below %d MB (what the code did after is not here)\tauditd\n", free, adm
			else if (adm != "" && free != "" && free <= 2 * adm)
				printf "alert\taudit_health\t1\tthe disk is nearly full: %d MB free, audit stops recording below %d MB\tauditd\n", free, adm
		}'
}

# pthhooks: alert pth_hook … — a .pth file written since prepare (any
# site-packages: the system's, ~/.local, a venv's) whose import line runs
# code at every start of Python: a shell, a subprocess, a connection,
# decoded code. Python runs a .pth's lines that start with "import";
# setuptools' own (distutils-precedence.pth, an editable install's finder)
# import a module and call it, none of these. Read with the code stopped
# (records), never followed through a link (-type f).
pthhooks() {
	find / -xdev -type f -name '*.pth' -cnewer "$M" ! -path "$S/*" ! -path "$N/*" ! -path "$T/*" \
		-exec grep -lE '^import[[:space:]].*(os\.system|os\.popen|os\.exec|subprocess|pty\.|socket|urllib|urlopen|http\.client|requests\.|exec\(|eval\(|compile\(|b64decode|base64|marshal|zlib|codecs\.decode|bytes\.fromhex)' {} + 2>/dev/null |
		awk '{ gsub(/[^[:print:]]/, "?"); printf "alert\tpth_hook\t1\t%s\t?\n", $0 }'
}

changed() {
	kind=$1
	shift
	find / -xdev "$@" ! -path "$S" ! -path "$S/*" ! -path "$N" ! -path "$N/*" ! -path "$T" ! -path "$T/*" ! -path /var/log/audit ! -path "/var/log/audit/*" -exec stat -c '%z|%n' {} + 2>/dev/null |
		awk -F'|' -v m="$since" -v w="$H/work/" -v kind="$kind" '
			$1 ~ /^[0-9][0-9][0-9][0-9]-/ && $1 > m {
				sub(/^[^|]*\|/, ""); gsub(/[^[:print:]]/, "?")
				# ~/work itself: its entries are the code'"'"'s own
				if ($0 "/" == w) next
				if (index($0, w) != 1) {
					print kind "\t" $0
					next
				}
				e = substr($0, length(w) + 1)
				sub(/\/.*/, "/", e)
				if (!(e in n))
					order[++k] = e
				n[e]++
			}
			END {
				for (i = 1; i <= k; i++)
					printf "work\t%s\t%s\t%d\n", kind, order[i], n[order[i]]
			}'
}

human() {
	awk -F'\t' -v w="$H/work/" '
		$1 == "since" { print "since:   " $2 }
		$1 == "user"  { print "user:    " $2; u = $2 }
		$1 == "token" { print "token:   " $2 }
		$1 == "section" {
			print ""
			if ($2 == "decoys") print "== decoys (READ: opened; TAMPERED: written, or its times reset)"
			if ($2 == "probes") print "== looking for a VM (absent: the lookup failed — not there, hidden from " u ", or not a directory; Node'"'"'s os.cpus() and build tools read /proc/cpuinfo too)"
			if ($2 == "privesc") print "== looking for a way to root (sudo, the password files, cron, container sockets, setuid and writable files; absent as above)"
			if ($2 == "exec")   print "== commands the code ran, in order (the first: mh-sandbox-run starting it)"
			if ($2 == "alerts") print "== alerts: what code does when it means harm (count, kind, what, by)"
			if ($2 == "files")  print "== files created or changed (in ~/work: counted per entry)"
			if ($2 == "dirs")   print "== directories whose entries changed (a file created, renamed or deleted in them)"
			if ($2 == "procs")  print "== processes left running as " u
			if ($2 == "listen") print "== listening sockets"
			if ($2 == "net")    print "== its network (the sandbox'"'"'s own: nothing left the VM)"
			if ($2 == "agent")  print "== text addressed to an AI agent, in the input (a signal, not proof)"
		}
		$1 == "decoy" {
			if ($2 == "untouched" || $2 == "DELETED") printf "%-16s %s\n", $2, $3
			else printf "%-16s %s   (legitimately: %s)\n", $2, $3, $4
		}
		$1 == "decoyby" { printf "  %3d× opened %s by %s\n", $3, $4, $5 }
		$1 == "audit" && $2 == "off" { print "  (no audit in this image: not recorded)" }
		$1 == "audit" && $3 + 0 > 0  { print "  (audit lost " $3 " events: this list may be incomplete)" }
		$1 == "probe" || $1 == "privesc" { printf "  %3d %-7s %s by %s\n", $3, $2, $4, $5 }
		$1 == "commands" && $2 > '"$maxexec"' { print "  (" $2 " distinct, the first '"$maxexec"' listed)" }
		$1 == "exec"   { printf "  %4d× %s\n", $2, $3 }
		$1 == "alert"  { printf "  %3d %-17s %s (by %s)\n", $3, $2, $4, $5 }
		$1 == "file" || $1 == "dir" { print "  " $2 }
		$1 == "work" && $3 ~ /\/$/ { printf "  %s%s  (%d inside)\n", w, $3, $4 }
		$1 == "work" && $3 !~ /\/$/ { print "  " w $3 }
		$1 == "proc"   { printf "  %6s  %s\n", $2, $3 }
		$1 == "listen" { printf "  %-5s %s\n", $2, $3 }
		$1 == "net" && $2 == "off" { print "  (no network of the sandbox in this image: names not recorded)" }
		$1 == "net" && $2 == "servfail" { print "  (no name answered)" }
		$1 == "net" && $2 == "sinkhole" { print "  (names answered into the sinkhole, which answers HTTP and HTTPS)" }
		$1 == "dns"  { printf "  %4d× looked up %-5s %s\n", $2, $3, $4 }
		$1 == "http" { printf "  %4d× %s %s  (%d bytes%s)\n", $2, $4, $5, $6, $7 ? ", WITH THE DECOY TOKEN" : "" }
		$1 == "tls"  { printf "  %4d× https %s  (refused the sinkhole'"'"'s certificate)\n", $2, $3 }
		$1 == "agent"  { printf "  %s:%s: %s\n", $3, $4, $5 }'
}

case "${1:-}" in
--tsv) records ;;
"") records | human ;;
*) echo "usage: mh-sandbox-report [--tsv]" >&2; exit 2 ;;
esac
