#!/bin/sh
# Prepares the sandbox: puts the decoys in the user's home and starts the clock.
# Run it as root (mh exec), once, AFTER copying the code in and BEFORE
# running it: everything changed after this moment is reported.
#
#   mh-sandbox-prepare [--no-sinkhole|--answers] [--ci] [ARCHIVE]
#
# ARCHIVE, a .tar.gz copied in with mh cp (which copies single files), is
# unpacked into ~/work as the user and removed, before the clock starts.
# Without it: the code was unpacked before (mh-sandbox-unpack), typically to
# fetch its dependencies first (mh-sandbox-run --fetch).
#
# The code's network is the sandbox's own, inside the VM (mh-sandbox-net):
# every name it looks up is answered with an address the VM holds, where a
# sinkhole answers HTTP and HTTPS and writes down what was sent.
# --no-sinkhole: no name is answered, as with no network at all.
# --answers: GitHub, npm's registry, AWS and Actions' OIDC answer as they
# would a logged-in user (mh-sandbox-net's Answers), not with an empty 200,
# on which a worm stops.
#
# --ci: the code runs as a CI job does (mh-sandbox-run): GitHub Actions'
# variables in its environment, and its secrets — GITHUB_TOKEN, NPM_TOKEN,
# AWS keys, PyPI's, the OIDC token's request — as decoys with this run's
# token in them. Code that steals from CI looks in the environment, not in
# ~/.npmrc: without them it finds nothing, and does nothing more.
#
# Root never writes inside the user's home: what is there may be the code's
# (a symlink to a system file), and root writing through it would be the
# escalation the sandbox exists to prevent. Root hands files over on stdin;
# the user writes them.
set -eu
. /usr/sbin/mh-sandbox-lib

[ "$(id -u)" = 0 ] || { echo "mh-sandbox-prepare: run as root (mh exec)" >&2; exit 1; }
[ ! -e "$S/since" ] || { echo "mh-sandbox-prepare: already prepared" >&2; exit 1; }
net=sinkhole
ci=
while [ $# -gt 0 ]; do
	case $1 in
	--no-sinkhole) net=servfail ;;
	--answers) net=answers ;;
	--ci) ci=1 ;;
	*) break ;;
	esac
	shift
done
# The environment reaches the code through setpriv's env -i (mh-sandbox-lib);
# busybox's su starts a clean one
[ -z "$ci" ] || setpriv --help 2>&1 | grep -q -- --reuid ||
	{ echo "mh-sandbox-prepare: --ci needs util-linux's setpriv (this image has busybox's)" >&2; exit 1; }

# Every read updates atime (not just the first in a day, relatime; nor never,
# noatime), whatever the image was mounted with.
mount -o remount,strictatime /
# Hardening, not reporting: the user sees no one else's processes (and so no
# command line of root's), nor kernel addresses or the kernel log, which help
# a privilege escalation.
mount -o remount,hidepid=2 /proc 2>/dev/null || true
sysctl -w kernel.kptr_restrict=2 kernel.dmesg_restrict=1 >/dev/null
# Out of memory, the kernel kills the code, never what reports on it: the
# agent mh talks to (and every command it starts from now on), audit, init,
# the journal (by its 15-character process name, as pgrep matches).
# mh-sandbox-run puts the code at the other end (1000), where it cannot climb
# back from. A build that outgrows the VM (go build in 512 MB) then fails as
# itself instead of taking the report with it.
for _p in 1 $(pgrep -x socat) $(pgrep -x auditd) $(pgrep -x systemd-journal); do
	echo -1000 > "/proc/$_p/oom_score_adj" 2>/dev/null || true
done

install -d -m 700 "$S"
asuser 'mkdir -p "$HOME/work"'

# The code first: the decoys, written after it, replace anything it put in
# their place.
[ $# -eq 0 ] || unpack mh-sandbox-prepare "$1"

# A token unique to this VM, inside every decoy: seen anywhere else (output,
# a request, a paste site), it came from here.
tok=$(head -c 10 /dev/urandom | od -An -tx1 | tr -d ' \n')
TOK=$(echo "$tok" | tr a-f A-F)
b64() { printf '%s' "$1" | base64 | tr -d '\n'; }

# decoy PATH [NOTE [TOOLS]]: installs stdin as PATH (relative to the user's
# home), mode 600, dated in the past — the code sees credentials that have
# been there a long time, and a read moves atime past the moment of
# preparing. NOTE says who reads that file legitimately, for whoever reads the
# report; TOOLS, those programs by name (audit's comm or the executable's
# name), space-separated: a read by them alone is the tool doing its job (npm
# reading ~/.npmrc), not the code reaching for a secret.
: > "$S/decoys"
decoy() {
	asuser 'cd "$HOME" && rm -rf "$0" && mkdir -p "$(dirname "$0")" && (umask 077 && cat > "$0") && touch -d "2025-01-01 00:00:00" "$0"' "$1"
	printf '%s\t%s\t%s\n' "$H/$1" "${2:-}" "${3:-}" >> "$S/decoys"
}

printf -- '-----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW\nQyNTUxOQAAACD%s\n-----END OPENSSH PRIVATE KEY-----\n' "$tok" |
	decoy .ssh/id_ed25519 "ssh reads it when connecting" "ssh scp sftp ssh-add"
printf 'Host prod-db\n    HostName 10.20.0.15\n    User deploy\n    IdentityFile ~/.ssh/id_ed25519\n' |
	decoy .ssh/config "ssh reads it when connecting" "ssh scp sftp"
printf '[default]\naws_access_key_id = AKIA%s\naws_secret_access_key = %s%s\nregion = eu-west-1\n' "$TOK" "$tok" "$tok" |
	decoy .aws/credentials "the AWS CLI and SDKs read it" "aws"
printf 'github.com:\n    oauth_token: ghp_%s%s\n    user: %s\n    git_protocol: https\n' "$tok" "$tok" "$U" |
	decoy .config/gh/hosts.yml "the gh CLI reads it" "gh"
printf 'https://%s:ghp_%s@github.com\n' "$U" "$tok" |
	decoy .git-credentials "git reads it with credential.helper store" "git-credential-store"
printf '//registry.npmjs.org/:_authToken=npm_%s%s\n' "$tok" "$tok" |
	decoy .npmrc "npm reads it on every run" "npm npx npm-cli.js npx-cli.js yarn pnpm"
printf '[pypi]\nusername = __token__\npassword = pypi-%s%s\n' "$tok" "$tok" |
	decoy .pypirc "twine reads it to upload" "twine"
printf 'machine api.heroku.com\n  login %s@example.com\n  password %s\n' "$U" "$tok" |
	decoy .netrc "curl -n, ftp, git setups, and Python's requests and pip on every request (a password for the host) read it" "curl ftp git-remote-http git-remote-https python python3 pip pip3"
printf '{\n  "auths": {\n    "ghcr.io": { "auth": "%s" }\n  }\n}\n' "$(b64 "$U:ghp_$tok")" |
	decoy .docker/config.json "docker reads it" "docker"
printf 'apiVersion: v1\nkind: Config\nclusters:\n- name: prod\n  cluster:\n    server: https://10.20.0.2:6443\ncontexts:\n- name: prod\n  context: {cluster: prod, user: admin}\ncurrent-context: prod\nusers:\n- name: admin\n  user:\n    token: %s%s\n' "$tok" "$tok" |
	decoy .kube/config "kubectl reads it" "kubectl helm"
printf 'DATABASE_URL=postgres://admin:%s@10.20.0.15:5432/billing\nSTRIPE_SECRET_KEY=sk_live_%s%s\nOPENAI_API_KEY=sk-proj-%s%s\n' "$tok" "$tok" "$tok" "$tok" "$tok" |
	decoy projects/billing-api/.env "the project's own app reads it"
printf 'cd projects/billing-api\nexport STRIPE_SECRET_KEY=sk_live_%s%s\npsql postgres://admin:%s@10.20.0.15:5432/billing\nssh prod-db\naws s3 ls\n' "$tok" "$tok" "$tok" |
	decoy .bash_history "an interactive bash reads it when it starts"
printf 'SQLite format 3\0001%s' "$tok" |
	decoy ".config/google-chrome/Default/Login Data" "only the browser reads it"
printf 'SQLite format 3\0002%s' "$tok" |
	decoy .config/google-chrome/Default/Cookies "only the browser reads it"
printf '{"nextId":2,"logins":[{"hostname":"https://github.com","encryptedUsername":"%s","encryptedPassword":"%s%s"}]}\n' "$tok" "$tok" "$tok" |
	decoy .mozilla/firefox/k3x9q2pd.default-release/logins.json "only the browser reads it"
printf 'SQLite format 3\0003%s' "$tok" |
	decoy .mozilla/firefox/k3x9q2pd.default-release/key4.db "only the browser reads it"
printf 'Created: 20250101T000000\nKey: (private-key (ecc (curve Ed25519)(flags eddsa)(q #40%s%s#)(d #%s%s#)))\n' "$TOK" "$TOK" "$TOK" "$TOK" |
	decoy .gnupg/private-keys-v1.d/7F3A9C2E41B85D6A0E19C4F27B3D8A51E6C09F42.key "gpg's agent reads it to sign or decrypt" "gpg gpg2 gpg-agent gpgsm"
printf '{"seed_version": 51, "wallet_type": "standard", "keystore": {"xprv": "xprv%s%s"}}\n' "$tok" "$tok" |
	decoy .electrum/wallets/default_wallet "only the wallet reads it"

# The AI coding agents' logins: what malware aimed at developers' machines
# reaches for (s1ngularity, @nx 2025, looked for claude, gemini and q).
# Files only, never the environment: code whose tests call an AI's API
# would send a key found there, and be graded for it.
printf '{"claudeAiOauth":{"accessToken":"sk-ant-oat01-%s%s%s","refreshToken":"sk-ant-ort01-%s%s%s","expiresAt":1893456000000,"scopes":["user:inference","user:profile"],"subscriptionType":"max"}}\n' "$tok" "$TOK" "$tok" "$TOK" "$tok" "$TOK" |
	decoy .claude/.credentials.json "Claude Code reads it to sign in" "claude"
printf '{\n  "access_token": "ya29.a0%s%s",\n  "refresh_token": "1//0g%s%s",\n  "scope": "https://www.googleapis.com/auth/cloud-platform openid",\n  "token_type": "Bearer",\n  "expiry_date": 1893456000000\n}\n' "$tok" "$TOK" "$TOK" "$tok" |
	decoy .gemini/oauth_creds.json "the Gemini CLI reads it to sign in" "gemini"
printf '{\n  "OPENAI_API_KEY": "sk-proj-%s%s%s",\n  "tokens": null,\n  "last_refresh": "2025-01-01T00:00:00Z"\n}\n' "$tok" "$TOK" "$tok" |
	decoy .codex/auth.json "the Codex CLI reads it to sign in" "codex"
printf '{"github.com:Iv1.b507a08c87ecfe98":{"user":"%s","oauth_token":"gho_%s%s","githubAppId":"Iv1.b507a08c87ecfe98"}}\n' "$U" "$tok" "$TOK" |
	decoy .config/github-copilot/apps.json "Copilot's editor plugins read it" "copilot-language-server copilot-agent"

echo "$tok" > "$S/token"

# --ci: a GitHub-hosted runner's environment, one VAR=value a line, words
# without spaces (mh-sandbox-run adds them to the code's). Root's: the code
# sees them in its environment, not in a file.
if [ -n "$ci" ]; then
	cat > "$S/ci" <<CI
CI=true
GITHUB_ACTIONS=true
RUNNER_OS=Linux
RUNNER_ARCH=X64
RUNNER_ENVIRONMENT=github-hosted
RUNNER_TEMP=/tmp
GITHUB_REPOSITORY=acme/billing-api
GITHUB_REPOSITORY_OWNER=acme
GITHUB_ACTOR=$U
GITHUB_WORKFLOW=release
GITHUB_EVENT_NAME=push
GITHUB_REF=refs/heads/main
GITHUB_REF_NAME=main
GITHUB_SHA=$tok$tok
GITHUB_RUN_ID=1$(printf '%d' "0x${tok%"${tok#????????}"}")
GITHUB_WORKSPACE=$H/work
GITHUB_SERVER_URL=https://github.com
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=ghs_$tok$TOK
GH_TOKEN=ghp_$TOK$tok
NPM_TOKEN=npm_$tok$tok
NODE_AUTH_TOKEN=npm_$tok$tok
AWS_ACCESS_KEY_ID=AKIA$TOK
AWS_SECRET_ACCESS_KEY=$tok$TOK
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
TWINE_USERNAME=__token__
TWINE_PASSWORD=pypi-$tok$tok
ACTIONS_ID_TOKEN_REQUEST_URL=https://pipelines.actions.githubusercontent.com/$tok/idtoken
ACTIONS_ID_TOKEN_REQUEST_TOKEN=$tok$TOK
ACTIONS_RUNTIME_TOKEN=$TOK$tok
CI
	chmod 600 "$S/ci"
fi

# Not a decoy (a list of public keys, no secret in it): there for code that
# adds its key to the one it finds, as on any machine reached by ssh. A
# write to it is persistence (auditrules watch ~/.ssh).
printf 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK0wmN/Cr3JXqmLW7u+g9pTh+wSN4RhCTTZaWyQx7Kp2 %s@laptop\n' "$U" |
	asuser 'cd "$HOME" && rm -rf .ssh/authorized_keys && (umask 077 && cat > .ssh/authorized_keys) && touch -d "2025-01-01 00:00:00" .ssh/authorized_keys'

# The code's network (mh-sandbox-net), in $N, owned by the user it runs as
# (mhsink): not root, not the code. resolv.conf is replaced, not written
# through: it is a link to the kernel's /proc/net/pnp. For the sinkhole:
# where the names point, /24s that look public picked for the run, is this
# VM's own (mh-sandbox-net's local routes: a connection there never reaches
# the host), and a CA of this run's, which
# the system trusts (mh-sandbox-lib points Node and pip at the system's
# list), signs its certificates. Where there is no python (the Alpine
# image) or no mhsink, nothing is answered and no name recorded; the report
# says so.
if command -v python3 >/dev/null && [ -x /usr/sbin/mh-sandbox-net ] && id mhsink >/dev/null 2>&1; then
	rm -rf "$N"
	install -d -o mhsink -g mhsink -m 700 "$N"
	if [ $net != servfail ]; then
		# a company's TLS-inspecting proxy's: a root made years ago, an
		# intermediate that signs (mhnet/ca.py)
		/usr/sbin/mh-sandbox-net "$N" ca </dev/null
		chown mhsink:mhsink "$N/ca.crt" "$N/inter.crt" "$N/inter.key"
		cp "$N/ca.crt" /usr/local/share/ca-certificates/acme-corp-root-ca.crt
		update-ca-certificates >/dev/null 2>&1
	fi
	# net: sinkhole or servfail, and answers after a tab (mh-sandbox-report)
	if [ $net = answers ]; then
		printf 'sinkhole\tanswers\n' > "$S/net"
	else
		echo $net > "$S/net"
	fi
	printf '%s' "$tok" | setsid /usr/sbin/mh-sandbox-net "$N" $net $U >/dev/null 2>&1 &
	echo -1000 > "/proc/$!/oom_score_adj" 2>/dev/null || true
	rm -f /etc/resolv.conf
	printf 'nameserver 127.53.0.1\n' > /etc/resolv.conf
	# A bare address (curl https://83.142.209.194/x, the cloud's metadata
	# at 169.254.169.254) asks no name: its HTTP and HTTPS go to the
	# sinkhole too, which reads where they were going (SO_ORIGINAL_DST).
	# Not the VM's own addresses (the sinkhole's range is local), nor
	# IPv6. An image without iptables: as before, the host refuses them.
	# One rule a port: the kernel has no multiport match.
	# A resolver of the code's own (dig @8.8.8.8, a resolver library given
	# 1.1.1.1): its queries, UDP and TCP, are answered by ours, as from
	# the address asked.
	if [ $net != servfail ] && command -v iptables-legacy >/dev/null; then
		for p in 80 443; do
			iptables-legacy -t nat -A OUTPUT -p tcp --dport $p -m addrtype ! --dst-type LOCAL -j REDIRECT 2>/dev/null ||
				echo "mh-sandbox-prepare: bare addresses' port $p not sent to the sinkhole: the host refuses them" >&2
		done
		for p in udp tcp; do
			iptables-legacy -t nat -A OUTPUT -p $p --dport 53 -m addrtype ! --dst-type LOCAL -j DNAT --to-destination 127.53.0.1:53 2>/dev/null ||
				echo "mh-sandbox-prepare: other resolvers' $p not sent to the sandbox's: the host refuses them" >&2
		done
	fi
	# up before the code can ask
	i=0
	while [ $i -lt 50 ] && ! ss -Hlun 'sport = :53' 2>/dev/null | grep -q 127.53.0.1; do
		sleep 0.1
		i=$((i + 1))
	done
fi

# The shell's startup files as they are, to say what the code added to them
# (rcsnap, rclines: mh-sandbox-lib).
rcsnap "$S/rc"

# The shells' trace (tracer, mh-sandbox-lib): what scripts do that runs no
# program — builtins, eval's decoded text — which audit does not see.
tracer

# Where there is audit (build.yml): every file the user opens, looks up or
# runs, found or not — the report picks out the ones that tell a VM apart —
# and what changes who it is, makes it start again, or reaches out
# (auditrules, mh-sandbox-lib). After the decoys, which the user wrote.
if command -v auditctl >/dev/null; then
	auditrules
	auditctl --reset-lost >/dev/null 2>&1
	auditctl --reset_backlog_wait_time_actual >/dev/null 2>&1
fi

# The clock: last, so that everything above is before it.
# the kernel's out-of-memory kills so far (the fetch's): the report counts
# the code's from here
awk '$1 == "oom_kill" { print $2 }' /proc/vmstat > "$S/oom" 2>/dev/null || true
touch "$S/since"
echo "prepared: $(wc -l < "$S/decoys") decoys in $H, token $tok"
