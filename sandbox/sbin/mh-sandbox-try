#!/bin/sh
# What mh sandbox runs for a package (npm:NAME, pypi:NAME) given no COMMAND:
# the package used the ways it can act — its install scripts, its import,
# each of its commands with --help — so that code which does something on
# install, on import or on start does it here. Run as the sandbox's user, in
# ~/work, after the fetch put the package there (node_modules/, .v/):
#
#   mh-sandbox-try npm NAME      # npm rebuild, import(NAME), each bin --help
#   mh-sandbox-try pypi NAME     # the sdist built (no wheel), import each top-level module and the packages right under it, each console script --help
#   mh-sandbox-try KIND NAME COMMAND   # COMMAND, its commands on the PATH
#
# An MCP server (its name says mcp, or it depends on the MCP SDK) is also
# spoken to, over stdin: initialize, then the lists of its tools, prompts
# and resources — the descriptions a model will read, where a poisoned
# server hides its instructions (mh sandbox scans the output for them).
# A COMMAND that starts one of its commands is that server started as the
# user's MCP config would: it is spoken to the same way, with its arguments
# as given, instead of waiting on a stdin nobody writes to.
#
# Everything it prints is the package's or about it: the code's to write.
# Each step has at most MH_TRY_TIMEOUT seconds (30); a step that fails is
# said and the next one runs: the exit code is the install's.
set -u
# --can command: this version takes a COMMAND (mh asks before giving one).
[ "${1:-}" = --can ] && [ "${2:-}" = command ] && exit 0
[ $# -eq 2 ] || [ $# -eq 3 ] || { echo "usage: mh-sandbox-try npm|pypi NAME [COMMAND]" >&2; exit 2; }
kind=$1 name=$2 command=${3:-}
per=${MH_TRY_TIMEOUT:-30}

# mcp [--as-given] CMD...: the handshake a client makes, then what it lists;
# stdin held open a few seconds for the answers. A server that wants a
# directory (filesystem) is given ~/work when it answered nothing without
# one — unless --as-given: the user's arguments are not added to. The
# server's exit, in mrc: 0 when it answered and was stopped by the timeout.
mcp() {
	retry=$HOME/work
	[ "$1" = --as-given ] && { retry=; shift; }
	echo "== $* (MCP: initialize, tools/list, prompts/list, resources/list)"
	for arg in "" ${retry:+"$retry"}; do
		out=$({
			printf '%s\n' \
				'{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"mh-sandbox","version":"1"}}}' \
				'{"jsonrpc":"2.0","method":"notifications/initialized"}' \
				'{"jsonrpc":"2.0","id":2,"method":"tools/list"}' \
				'{"jsonrpc":"2.0","id":3,"method":"prompts/list"}' \
				'{"jsonrpc":"2.0","id":4,"method":"resources/list"}'
			sleep 5
		} | timeout 15 "$@" ${arg:+"$arg"} 2>&1)
		mrc=$?
		case $out in *'"jsonrpc"'*) [ $mrc -eq 124 ] && mrc=0; break ;; esac
	done
	printf '%s\n' "$out"
}

# given CMDS SDK: the COMMAND, run in place of the tries. When its first
# word is one of the package's commands (CMDS) and the package is an MCP
# server, it is that server started, and it is spoken to; otherwise it runs.
given() {
	first=${command#"${command%%[! 	]*}"}
	first=${first%%[ 	]*}
	first=${first##*/}
	for c in $1; do
		[ "$first" = "$c" ] || continue
		case "$2 $name $c" in
		*[Mm][Cc][Pp]*)
			mcp --as-given bash -c "$command"
			exit $mrc
			;;
		esac
	done
	exec bash -c "$command"
}

case $kind in
npm)
	echo "== npm rebuild: its install scripts, and its dependencies'"
	npm rebuild --foreground-scripts
	rc=$?
	bins=$(node -e '
const p = require(require("path").resolve("node_modules", process.argv[1], "package.json"));
const b = typeof p.bin === "string" ? { [p.name.split("/").pop()]: p.bin } : (p.bin || {});
console.log(Object.keys(b).join("\n"))' "$name")
	sdk=$(node -e '
const p = require(require("path").resolve("node_modules", process.argv[1], "package.json"));
console.log("@modelcontextprotocol/sdk" in { ...p.dependencies, ...p.peerDependencies } ? "mcp" : "")' "$name")
	if [ -n "$command" ]; then
		export PATH="$HOME/work/node_modules/.bin:$PATH"
		given "$bins" "$sdk"
	fi
	echo "== import $name"
	timeout "$per" node -e '
import(process.argv[1]).then(
  m => console.log("imported:", Object.keys(m).slice(0, 20).join(" ")),
  e => console.log("import failed:", e && e.message))' "$name"
	for b in $bins; do
		echo "== $b --help"
		timeout "$per" "./node_modules/.bin/$b" --help </dev/null
		case "$sdk $name $b" in *[Mm][Cc][Pp]*) mcp "./node_modules/.bin/$b" ;; esac
	done
	exit $rc
	;;
pypi)
	rc=0
	if [ -d .sdist ]; then
		# no wheel: the fetch left the sdist unbuilt (mh-sandbox-sdist);
		# building and installing it runs its setup.py, here
		echo "== pip install the sdist: its build, its setup.py"
		set -- .sdist/*.tar.gz .sdist/*.zip
		for a; do [ -f "$a" ] && sdist=$a; done
		set -- .sdist/wheels/*.whl
		[ -f "$1" ] && .v/bin/pip install -q --disable-pip-version-check --no-index --find-links .sdist/wheels "$@"
		.v/bin/pip install --disable-pip-version-check --no-index --find-links .sdist/wheels --no-build-isolation "$sdist" 2>&1
		rc=$?
	fi
	scripts=$(.v/bin/python -c '
import importlib.metadata as md, sys
print("\n".join(e.name for e in md.distribution(sys.argv[1]).entry_points if e.group == "console_scripts"))' "$name")
	sdk=$(.v/bin/python -c '
import importlib.metadata as md, re, sys
print("mcp" if any(re.match(r"mcp\b", r) for r in md.distribution(sys.argv[1]).requires or []) else "")' "$name")
	if [ -n "$command" ]; then
		export PATH="$HOME/work/.v/bin:$PATH"
		given "$scripts" "$sdk"
	fi
	echo "== import $name's modules"
	timeout "$per" .v/bin/python - "$name" <<'EOF'
import importlib, importlib.metadata as md, sys
d = md.distribution(sys.argv[1])
# Its modules, from the files it installed: top_level.txt is setuptools'
# alone (hatchling, flit write none), and a namespace package has no
# __init__.py at the top (mistralai). Then each package right under a top
# one: code in mistralai/client/__init__.py runs on import mistralai.client,
# not on import mistralai.
mods = set((d.read_text("top_level.txt") or "").split())
for f in d.files or []:
    p = f.parts
    if p[0].endswith((".dist-info", ".data")) or p[0] in ("..", "__pycache__"):
        continue
    if len(p) == 1 and p[0].endswith(".py"):
        mods.add(p[0][:-3])
    elif len(p) >= 2 and p[-1].endswith(".py"):
        mods.add(p[0])
        if len(p) == 3 and p[2] == "__init__.py":
            mods.add(p[0] + "." + p[1])
for t in sorted(mods):
    if not all(w.isidentifier() for w in t.split(".")):
        continue
    try:
        importlib.import_module(t)
        print("imported:", t)
    except BaseException as e:
        print("import", t, "failed:", type(e).__name__, e)
EOF
	for s in $scripts; do
		echo "== $s --help"
		timeout "$per" ".v/bin/$s" --help </dev/null
		case "$sdk $name $s" in *[Mm][Cc][Pp]*) mcp ".v/bin/$s" ;; esac
	done
	exit $rc
	;;
*)
	echo "mh-sandbox-try: npm or pypi, not $kind" >&2
	exit 2
	;;
esac
