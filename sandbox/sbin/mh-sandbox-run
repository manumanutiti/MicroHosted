#!/bin/sh
# Runs one command line as the sandbox's user, in its ~/work, unable to gain
# privileges (no_new_privs: setuid and file capabilities do nothing), in bash
# where there is one. Its exit code is the command's. Run it as root (mh
# exec), after mh-sandbox-prepare:
#
#   mh exec -t 5m VM mh-sandbox-run 'npm install && npm test'
#
# --fetch runs it BEFORE mh-sandbox-prepare instead — no decoys yet, nothing
# reported — to download the code's dependencies while the VM has a network.
# The command must run nothing of the code: npm ci --ignore-scripts,
# pip download --only-binary=:all:, go mod download. Then the network is cut
# (mh quarantine), the VM prepared, and the code run without one:
#
#   mh exec -t 5m VM -- mh-sandbox-run --fetch 'npm ci --ignore-scripts'
. /usr/sbin/mh-sandbox-lib

[ "$(id -u)" = 0 ] || { echo "mh-sandbox-run: run as root (mh exec)" >&2; exit 1; }
fetch=
if [ "${1:-}" = --fetch ]; then
	fetch=1
	shift
	[ ! -e "$S/since" ] || { echo "mh-sandbox-run: --fetch is before mh-sandbox-prepare, and this VM is prepared" >&2; exit 1; }
else
	[ -e "$S/since" ] || { echo "mh-sandbox-run: not prepared: run mh-sandbox-prepare first (or --fetch, to download before it)" >&2; exit 1; }
fi
[ $# -gt 0 ] || { echo "usage: mh-sandbox-run [--fetch] COMMAND..." >&2; exit 2; }

asuser 'mkdir -p "$HOME/work" && cd "$HOME/work" && exec "$0" -c "$1"' "$SH" "$*"
rc=$?
# A fetch ends when its connections have closed (at most 10 s): cut while one
# is still closing, its last packets are refused and recorded as if the code
# had sent them.
if [ -n "$fetch" ] && command -v ss >/dev/null; then
	i=0
	while [ $i -lt 50 ] && [ -n "$(ss -Htn state all exclude listening exclude time-wait exclude closed)" ]; do
		sleep 0.2
		i=$((i + 1))
	done
fi
exit $rc
