#!/usr/bin/env python3
# The sandbox's network, inside the VM: a resolver and a sinkhole. Nothing
# leaves the VM; what the code meant to reach is written down.
#
#   mh-sandbox-net DIR sinkhole|answers USER|servfail < TOKEN
#
# mh-sandbox-prepare starts it as root. It binds its ports, reads this run's
# decoy token on stdin and DIR's CA, then becomes DIR's owner (mhsink): what
# it parses is the code's to choose, and a mistake here must not hand the
# code root.
#
# The resolver, on 127.53.0.1:53 (resolv.conf points at it), writes down
# every name looked up. sinkhole: an A query is answered with an address of
# its own for each name, in 198.18.0.0/15 — a range the VM holds locally
# (mh-sandbox-prepare's route), so a connection to it never reaches the host;
# any other type has no answer. servfail: no name is answered, as with no
# network at all.
#
# The sinkhole, on ports 80 and 443 of those addresses, and of any bare
# address the code connects to (mh-sandbox-prepare redirects them here; the
# address it meant is read back, SO_ORIGINAL_DST): an HTTP request is
# answered 200 and empty, and written down — method, URL, size, and whether
# this run's decoy token is in it (as is, URL- or base64-encoded, gzipped):
# a secret sent out. answers: the services worms go for — GitHub's API,
# npm's registry, AWS's STS and Secrets Manager, Actions' OIDC token — are
# answered as for USER, logged in (Answers, below); the rest as sinkhole.
# HTTPS is answered with a certificate for the name,
# signed by DIR's CA, which the VM trusts (mh-sandbox-prepare); a client
# with its own list of authorities refuses it, and only the name it asked
# for (SNI) is written down.
#
# DIR gets, one record per line, tab-separated, every field the code's
# choice made printable and cut:
#   dns    TYPE NAME
#   addr   ADDRESS NAME            (the address given to NAME)
#   http   SCHEME METHOD URL BYTES TOKEN(0|1|2) PORT ANSWER
#                                  (TOKEN 2: only in its own service's header, OWN)
#                                  (ANSWER: the answer given, - for the empty 200)
#   tls    NAME refused            (the client did not accept the certificate)
# and, last on each, the time it was written (seconds since the epoch).
# At most 50000 records: a loop says nothing new after that.
import base64
import binascii
import hashlib
import io
import ipaddress
import json
import os
import re
import socket
import ssl
import subprocess
import sys
import tarfile
import threading
import time
import urllib.parse
import zlib

RESOLVER = "127.53.0.1"
SINK = ipaddress.ip_network("198.18.0.0/15")
TYPES = {1: "A", 2: "NS", 5: "CNAME", 6: "SOA", 12: "PTR", 15: "MX", 16: "TXT",
         28: "AAAA", 33: "SRV", 64: "SVCB", 65: "HTTPS", 255: "ANY"}
MAXRECORDS = 50000
MAXBODY = 1 << 20  # what is kept of a request, to look for the token in
HOSTNAME = re.compile(r"^[a-z0-9_]([a-z0-9_-]{0,62}\.)*[a-z0-9_-]{1,63}\.?$")


def printable(s, n):
    return "".join(c if c.isprintable() and c != "\t" else "?" for c in s)[:n]


class Log:
    def __init__(self, path):
        self.f = open(path, "a", buffering=1)
        self.n = 0
        self.lock = threading.Lock()

    def write(self, *fields):
        with self.lock:
            if self.n < MAXRECORDS:
                self.f.write("\t".join(str(f) for f in fields) + "\t%.3f\n" % time.time())
                self.n += 1


class Names:
    """Each name its own address in the sinkhole's range, in the order asked."""

    def __init__(self, log):
        self.log = log
        self.by_name, self.by_addr = {}, {}
        self.lock = threading.Lock()

    def addr(self, name):
        with self.lock:
            a = self.by_name.get(name)
            if a is None:
                if len(self.by_name) >= SINK.num_addresses - 2:
                    return None
                a = SINK.network_address + 1 + len(self.by_name)
                self.by_name[name], self.by_addr[a] = a, name
                self.log.write("addr", a, name)
            return a

    def name(self, addr):
        with self.lock:
            return self.by_addr.get(ipaddress.ip_address(addr))


# --- the resolver -----------------------------------------------------------

def question(pkt):
    """The first question's name and type, and where the question ends."""
    if len(pkt) < 12 or int.from_bytes(pkt[4:6], "big") < 1:
        return None
    i, labels = 12, []
    while True:
        if i >= len(pkt):
            return None
        n = pkt[i]
        i += 1
        if n == 0:
            break
        if n & 0xC0 or i + n > len(pkt):  # no compression in a question
            return None
        labels.append(pkt[i:i + n])
        i += n
    if i + 4 > len(pkt):
        return None
    name = printable(b".".join(labels).decode("ascii", "replace").lower(), 253) or "."
    return name, int.from_bytes(pkt[i:i + 2], "big"), i + 4


def resolver(sock, log, names, sinkhole):
    while True:
        try:
            pkt, peer = sock.recvfrom(4096)
        except InterruptedError:
            continue
        q = question(pkt)
        if q is None or pkt[2] & 0x80:  # not a query
            continue
        name, qtype, end = q
        log.write("dns", TYPES.get(qtype, str(qtype)), name)
        answer = b""
        rcode = 0 if sinkhole else 2  # servfail: as with no network
        if sinkhole and qtype == 1 and HOSTNAME.match(name):
            a = names.addr(name)
            if a is not None:
                # the name by pointer to the question, A, IN, 60 s, the address
                answer = b"\xc0\x0c\x00\x01\x00\x01\x00\x00\x00\x3c\x00\x04" + a.packed
        # the id, the opcode and RD as asked; QR, AA, RA set
        flags = bytes([0x84 | (pkt[2] & 0x79), 0x80 | rcode])
        counts = b"\x00\x01" + (b"\x00\x01" if answer else b"\x00\x00") + b"\x00\x00\x00\x00"
        try:
            sock.sendto(pkt[0:2] + flags + counts + pkt[12:end] + answer, peer)
        except OSError:
            pass


# --- the sinkhole -----------------------------------------------------------

def carries(data, token, depth=0):
    """Whether data has the token in it: as is, or under up to three layers
    of URL-encoding, base64 and gzip, in any order (gzip of base64 of a
    file is a stealer's usual)."""
    if not token:
        return False
    if token in data.lower():
        return True
    if depth == 3:
        return False
    layers = []
    if b"%" in data:
        try:
            layers.append(urllib.parse.unquote_to_bytes(data))
        except Exception:
            pass
    for run in re.findall(rb"[A-Za-z0-9+/_-]{24,}={0,2}", data)[:50]:
        for dec in (base64.b64decode, base64.urlsafe_b64decode):
            try:
                layers.append(dec(run + b"=" * (-len(run) % 4)))
                break
            except (binascii.Error, ValueError):
                pass
    i = data.find(b"\x1f\x8b")
    if i >= 0:
        try:
            layers.append(zlib.decompressobj(31).decompress(data[i:], 4 * MAXBODY))
        except zlib.error:
            pass
    return any(carries(d, token, depth + 1) for d in layers if d != data)


# Where a decoy's credential goes as it should: to its own service, in the
# header that service reads (a tool logged in, npm whoami with NPM_TOKEN).
# By host: the headers dropped before looking for the token again, and
# whether the request line goes too (the OIDC token's URL is a secret).
# The first that matches.
OWN = [(re.compile(r"^pipelines\.actions\.githubusercontent\.com$"), ("authorization",), True),
       (re.compile(r"^(api\.github\.com|github\.com|uploads\.github\.com|ghcr\.io|[a-z0-9.-]+\.githubusercontent\.com)$"), ("authorization",), False),
       (re.compile(r"^registry\.(npmjs\.org|yarnpkg\.com)$"), ("authorization", "npm-auth-type"), False),
       (re.compile(r"^(upload\.pypi\.org|test\.pypi\.org)$"), ("authorization",), False),
       (re.compile(r"^[a-z0-9.-]+\.amazonaws\.com$"), ("authorization", "x-amz-security-token"), False)]


def token_field(host, head, body, token):
    """0: the token is not in the request; 1: it is — a secret sent out;
    2: only where its own service reads it (OWN): a credential used, not
    sent out. Anywhere else in the request — the body, the query, another
    header — is 1."""
    if not carries(head + b"\r\n\r\n" + body, token):
        return 0
    host = host.lower().split(":")[0]
    for pat, headers, line in OWN:
        if pat.match(host):
            lines = head.split(b"\r\n")
            rest = [l for i, l in enumerate(lines)
                    if not (i == 0 and line) and l.split(b":", 1)[0].strip().lower().decode("latin-1") not in headers]
            return 2 if not carries(b"\r\n".join(rest) + b"\r\n\r\n" + body, token) else 1
    return 1


def read_request(conn):
    """The request's head and as much of its body as is kept, and its size."""
    data = b""
    while b"\r\n\r\n" not in data and len(data) < 65536:
        chunk = conn.recv(65536)
        if not chunk:
            break
        data += chunk
    head, _, body = data.partition(b"\r\n\r\n")
    want = 0
    m = re.search(rb"(?im)^content-length:\s*(\d+)", head)
    if m:
        want = int(m.group(1))
    elif re.search(rb"(?im)^transfer-encoding:\s*chunked", head):
        want = MAXBODY  # until it stops, or the timeout
    total = len(body)
    while total < want:
        chunk = conn.recv(65536)
        if not chunk:
            break
        total += len(chunk)
        if len(body) < MAXBODY:
            body += chunk[:MAXBODY - len(body)]
    return head, body, total


def serve(conn, scheme, port, host, log, token, answers):
    try:
        head, body, size = read_request(conn)
        line = head.split(b"\r\n", 1)[0].decode("latin-1")
        parts = line.split(" ")
        method, target = (parts[0], parts[1]) if len(parts) >= 2 else ("?", "")
        m = re.search(rb"(?im)^host:\s*([^\r\n]+)", head)
        if m:
            host = m.group(1).decode("latin-1").strip()
        url = target if "://" in target else scheme + "://" + host + target
        a = None
        if answers is not None:
            try:
                a = answers.answer(method.upper(), url, head, body)
            except Exception:  # what the code sent is the code's: an empty 200 then
                a = None
        log.write("http", scheme, printable(method, 16), printable(url, 300), size,
                  token_field(urllib.parse.urlsplit(url).hostname or "", head, body, token), port, a[0] if a else "-")
        if a is None:
            conn.sendall(b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
            return
        _, status, ctype, out, extra = a
        hdr = "HTTP/1.1 %s\r\nContent-Type: %s\r\nContent-Length: %d\r\nConnection: close\r\n" % (status, ctype, len(out))
        hdr += "".join("%s: %s\r\n" % kv for kv in extra)
        conn.sendall(hdr.encode() + b"\r\n" + out)
    except (OSError, ssl.SSLError, UnicodeError):
        pass


# --- answers ----------------------------------------------------------------

class Answers:
    """--answers: what the services worms go for would answer, for an
    identity made up for this run — the VM's user, a repository, a package,
    an AWS account — instead of an empty 200, on which they stop: after
    whoami, after creating a repository. What they do next shows. Every
    secret handed out (an OIDC token, a runner's registration token, a
    secret's value) has this run's token in it, so sending it on is a secret
    sent out, as a decoy's. Nothing in an answer is the code's choice but
    the names it echoes; what nothing here knows gets the empty 200.

    Each answer: (its name, for the report; status; content type; body;
    more headers)."""

    ORG, REPO, PKG = "acme", "billing-api", "acme-billing-utils"

    def __init__(self, user, token):
        self.user = user
        self.tok = token.decode()
        self.TOK = self.tok.upper()
        self.account = "%012d" % (int(self.tok[:10] or "0", 16) % 10 ** 12)
        self.tgz = self.tarball()

    def sha(self, *words):
        return hashlib.sha1(("\0".join((self.tok,) + words)).encode()).hexdigest()

    @staticmethod
    def js(name, obj, status="200 OK", extra=()):
        return name, status, "application/json; charset=utf-8", json.dumps(obj).encode(), list(extra)

    @staticmethod
    def amz(name, obj):
        return name, "200 OK", "application/x-amz-json-1.1", json.dumps(obj).encode(), []

    @staticmethod
    def field(body, key, default):
        try:
            v = json.loads(body.decode("utf-8")).get(key)
        except (ValueError, AttributeError, UnicodeError):
            return default
        return printable(v, 100) if isinstance(v, str) and v else default

    def answer(self, method, url, head, body):
        u = urllib.parse.urlsplit(url)
        host, path = (u.hostname or "").lower(), u.path
        if host == "api.github.com":
            return self.github(method, path, body)
        if host in ("registry.npmjs.org", "registry.yarnpkg.com"):
            return self.npm(method, path, u.query)
        if host.endswith(".amazonaws.com"):
            return self.aws(host, head, body)
        if host.endswith(".actions.githubusercontent.com") and "idtoken" in path:
            return self.oidc()
        return None

    # GitHub, as a token with repo and workflow scopes sees it
    def github(self, method, path, body):
        scopes = [("X-OAuth-Scopes", "repo, workflow, read:org, write:packages"),
                  ("X-GitHub-Media-Type", "github.v3; format=json")]
        full = self.ORG + "/" + self.REPO

        def repo(owner, name, private=True):
            return {"id": int(self.sha(owner, name)[:7], 16), "name": name, "full_name": owner + "/" + name,
                    "owner": {"login": owner, "type": "Organization" if owner == self.ORG else "User"},
                    "private": private, "default_branch": "main",
                    "html_url": "https://github.com/%s/%s" % (owner, name),
                    "clone_url": "https://github.com/%s/%s.git" % (owner, name),
                    "permissions": {"admin": True, "maintain": True, "push": True, "triage": True, "pull": True}}

        if method == "GET" and path == "/user":
            return self.js("github user", {"login": self.user, "id": int(self.sha("user")[:7], 16), "type": "User",
                                           "name": self.user, "company": "@" + self.ORG, "public_repos": 3,
                                           "total_private_repos": 1, "two_factor_authentication": False}, extra=scopes)
        if method == "GET" and path in ("/user/repos", "/orgs/%s/repos" % self.ORG):
            return self.js("github repositories", [repo(self.ORG, self.REPO)], extra=scopes)
        if method == "GET" and path == "/user/orgs":
            return self.js("github orgs", [{"login": self.ORG, "id": int(self.sha("org")[:7], 16)}], extra=scopes)
        if method == "POST" and path in ("/user/repos", "/orgs/%s/repos" % self.ORG):
            owner = self.user if path == "/user/repos" else self.ORG
            name = self.field(body, "name", "repository")
            return self.js("github repository created", repo(owner, name, private=False), "201 Created", scopes)
        m = re.match(r"^/repos/([^/]+)/([^/]+)(/.*)?$", path)
        if not m:
            return None
        owner, name, rest = m.group(1), m.group(2), m.group(3) or ""
        if owner not in (self.ORG, self.user):  # another's: as the sinkhole
            return None
        if method == "GET" and rest == "":
            return self.js("github repository", repo(owner, name), extra=scopes)
        if method == "GET" and re.match(r"^/git/refs?/heads/", rest):
            ref = "refs/heads/" + rest.split("/heads/", 1)[1]
            return self.js("github ref", {"ref": ref, "object": {"sha": self.sha(owner, name, ref), "type": "commit"}}, extra=scopes)
        if method == "POST" and rest == "/git/refs":
            ref = self.field(body, "ref", "refs/heads/main")
            return self.js("github ref created", {"ref": ref, "object": {"sha": self.sha(owner, name, ref), "type": "commit"}},
                           "201 Created", scopes)
        if method == "PUT" and rest.startswith("/contents/"):
            p = rest[len("/contents/"):]
            return self.js("github file written", {"content": {"name": p.rsplit("/", 1)[-1], "path": p, "sha": self.sha(p)},
                                                   "commit": {"sha": self.sha(owner, name, p, "commit")}}, "201 Created", scopes)
        if method == "POST" and rest == "/actions/runners/registration-token":
            return self.js("github runner token", {"token": "A" + self.TOK + self.TOK, "expires_at": "2099-01-01T00:00:00Z"},
                           "201 Created", scopes)
        if method == "GET" and rest in ("/actions/secrets", "/actions/variables"):
            return self.js("github secrets", {"total_count": 0, rest.rsplit("/", 1)[1]: []}, extra=scopes)
        return None

    # npm: the user owns a package, which it can fetch and publish again
    def npm(self, method, path, query):
        reg = "https://registry.npmjs.org/"
        if method == "GET" and path == "/-/whoami":
            return self.js("npm whoami", {"username": self.user})
        if method == "GET" and path == "/-/v1/search":
            return self.js("npm search", {"total": 1, "objects": [{"package": {
                "name": self.PKG, "version": "1.0.0", "publisher": {"username": self.user},
                "maintainers": [{"username": self.user}], "links": {"npm": "https://www.npmjs.com/package/" + self.PKG}}}]})
        if method == "GET" and path in ("/-/user/org.couchdb.user:" + self.user, "/-/npm/v1/user"):
            return self.js("npm user", {"name": self.user, "email": self.user + "@" + self.ORG + ".dev", "tfa": False})
        if method == "GET" and path == "/" + self.PKG:
            meta = {"name": self.PKG, "version": "1.0.0", "main": "index.js", "license": "MIT",
                    "maintainers": [{"name": self.user}],
                    "dist": {"tarball": reg + self.PKG + "/-/" + self.PKG + "-1.0.0.tgz",
                             "shasum": hashlib.sha1(self.tgz).hexdigest(),
                             "integrity": "sha512-" + base64.b64encode(hashlib.sha512(self.tgz).digest()).decode()}}
            return self.js("npm package", {"name": self.PKG, "dist-tags": {"latest": "1.0.0"},
                                           "versions": {"1.0.0": meta}, "maintainers": [{"name": self.user}]})
        if method == "GET" and path == "/%s/-/%s-1.0.0.tgz" % (self.PKG, self.PKG):
            return "npm tarball", "200 OK", "application/octet-stream", self.tgz, []
        if method == "PUT" and not path.startswith("/-/"):
            return self.js("npm published", {"ok": True, "success": True, "id": printable(urllib.parse.unquote(path[1:]), 100)})
        return None

    def tarball(self):
        """The package's tarball: a package.json and an index.js, made here."""
        files = {"package/package.json": json.dumps({"name": self.PKG, "version": "1.0.0", "main": "index.js",
                                                    "license": "MIT"}, indent=2).encode(),
                 "package/index.js": b"module.exports = (n) => Math.round(n * 100) / 100;\n"}
        buf = io.BytesIO()
        with tarfile.open(fileobj=buf, mode="w:gz") as t:
            for name, data in files.items():
                ti = tarfile.TarInfo(name)
                ti.size, ti.mode, ti.mtime = len(data), 0o644, 1704067200
                t.addfile(ti, io.BytesIO(data))
        return buf.getvalue()

    # AWS: the keys are a user's of an account; it has one secret
    def aws(self, host, head, body):
        m = re.search(rb"(?im)^x-amz-target:\s*([^\r\n]+)", head)
        target = m.group(1).decode("latin-1").strip() if m else ""
        region = host.split(".")[1] if host.count(".") >= 3 else "us-east-1"
        arn = "arn:aws:iam::%s:user/%s" % (self.account, self.user)
        if host.startswith("sts.") and (b"GetCallerIdentity" in body or target.endswith("GetCallerIdentity")):
            ident = {"Account": self.account, "Arn": arn, "UserId": "AIDA" + self.TOK[:17]}
            if target:
                return self.amz("aws identity", ident)
            xml = ('<GetCallerIdentityResponse xmlns="https://sts.amazonaws.com/doc/2011-06-15/"><GetCallerIdentityResult>'
                   "<Arn>%s</Arn><UserId>%s</UserId><Account>%s</Account></GetCallerIdentityResult>"
                   "<ResponseMetadata><RequestId>%s</RequestId></ResponseMetadata></GetCallerIdentityResponse>"
                   % (arn, ident["UserId"], self.account, self.sha("sts")[:36]))
            return "aws identity", "200 OK", "text/xml", xml.encode(), []
        if host.startswith("secretsmanager."):
            name = "prod/%s/database" % self.REPO
            sarn = "arn:aws:secretsmanager:%s:%s:secret:%s-%s" % (region, self.account, name, self.tok[:6])
            if target.endswith("ListSecrets"):
                return self.amz("aws secrets", {"SecretList": [{"ARN": sarn, "Name": name}]})
            if target.endswith("GetSecretValue"):
                v = {"ARN": sarn, "Name": name, "VersionId": self.sha("v")[:32],
                     "SecretString": json.dumps({"username": "billing", "password": self.tok + self.TOK,
                                                 "host": "billing.cluster-%s.%s.rds.amazonaws.com" % (self.tok[:12], region)})}
                return self.amz("aws secret value", v)
        return None

    # GitHub Actions' OIDC token, for --ci's ACTIONS_ID_TOKEN_REQUEST_URL
    def oidc(self):
        b64 = lambda o: base64.urlsafe_b64encode(json.dumps(o).encode()).decode().rstrip("=")
        claims = {"iss": "https://token.actions.githubusercontent.com", "aud": "sigstore",
                  "sub": "repo:%s/%s:ref:refs/heads/main" % (self.ORG, self.REPO), "repository": self.ORG + "/" + self.REPO,
                  "jti": self.tok, "exp": 4102444800}
        return self.js("github oidc token", {"value": b64({"alg": "RS256", "typ": "JWT"}) + "." + b64(claims) + "." + self.tok + self.TOK})


def is_ip(s):
    try:
        ipaddress.ip_address(s)
        return True
    except ValueError:
        return False


class Certs:
    """A certificate for each name, signed by DIR's CA."""

    def __init__(self, d):
        self.d = d
        self.ctxs = {}
        self.lock = threading.Lock()

    def ctx(self, name):
        with self.lock:
            c = self.ctxs.get(name)
            if c is not None:
                return c
            base = os.path.join(self.d, "certs", re.sub(r"[^a-z0-9.-]", "_", name))
            ext = base + ".ext"
            with open(ext, "w") as f:
                f.write("subjectAltName=%s:%s\nextendedKeyUsage=serverAuth\n" % ("IP" if is_ip(name) else "DNS", name))
            subprocess.run(["openssl", "req", "-new", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1",
                            "-nodes", "-keyout", base + ".key", "-subj", "/CN=" + name, "-out", base + ".csr"],
                           check=True, capture_output=True, timeout=20)
            subprocess.run(["openssl", "x509", "-req", "-in", base + ".csr", "-CA", os.path.join(self.d, "ca.crt"),
                            "-CAkey", os.path.join(self.d, "ca.key"), "-set_serial", str(int.from_bytes(os.urandom(8), "big")),
                            "-days", "30", "-extfile", ext, "-out", base + ".crt"],
                           check=True, capture_output=True, timeout=20)
            c = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
            c.load_cert_chain(base + ".crt", base + ".key")
            self.ctxs[name] = c
            return c


SO_ORIGINAL_DST = 80  # linux/netfilter_ipv4.h


def original_dst(conn):
    """Where a connection mh-sandbox-prepare's REDIRECT sent here was going:
    a bare address the code connected to, or None (not redirected)."""
    try:
        raw = conn.getsockopt(socket.SOL_IP, SO_ORIGINAL_DST, 16)
    except OSError:
        return None
    a = ipaddress.ip_address(raw[4:8])
    return None if a.is_loopback or a in SINK else a


def sinkhole(sock, port, tls, log, names, token, certs, slots, answers):
    while True:
        try:
            conn, _ = sock.accept()
        except InterruptedError:
            continue
        local = ipaddress.ip_address(conn.getsockname()[0])
        # a name's address, by its name; a bare address, as itself
        host = (names.name(local) or local) if local in SINK else original_dst(conn)
        if host is None or not slots.acquire(blocking=False):
            conn.close()
            continue
        host = str(host)

        def handle(conn=conn, host=host):
            try:
                conn.settimeout(5)
                if not tls:
                    serve(conn, "http", port, host, log, token, answers)
                    return
                asked = {"name": host}

                def sni(sslobj, server_name, _ctx):
                    if server_name and HOSTNAME.match(server_name.lower()):
                        asked["name"] = server_name.lower()
                    try:
                        sslobj.context = certs.ctx(asked["name"])
                    except Exception:
                        return ssl.ALERT_DESCRIPTION_INTERNAL_ERROR
                    return None

                ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
                ctx.sni_callback = sni
                ctx.load_cert_chain(*certs_default)
                try:
                    s = ctx.wrap_socket(conn, server_side=True)
                except (ssl.SSLError, OSError):
                    log.write("tls", printable(asked["name"], 253), "refused")
                    return
                serve(s, "https", port, asked["name"], log, token, answers)
            finally:
                conn.close()
                slots.release()

        threading.Thread(target=handle, daemon=True).start()


def main():
    global certs_default
    d, mode = sys.argv[1], sys.argv[2]
    token = sys.stdin.read().strip().lower().encode()
    answers = Answers(sys.argv[3], token) if mode == "answers" else None
    if answers:
        mode = "sinkhole"
    udp = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    udp.bind((RESOLVER, 53))
    tcp = []
    if mode == "sinkhole":
        for port in (80, 443):
            t = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            t.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            t.bind(("0.0.0.0", port))
            t.listen(128)
            tcp.append((t, port))
    # root no longer: DIR's owner
    st = os.stat(d)
    if os.getuid() == 0:
        os.setgroups([])
        os.setgid(st.st_gid)
        os.setuid(st.st_uid)
    if os.getuid() == 0:
        sys.exit("mh-sandbox-net: DIR must not be root's")

    log = Log(os.path.join(d, "log"))
    names = Names(log)
    certs = Certs(d)
    os.makedirs(os.path.join(d, "certs"), exist_ok=True)
    slots = threading.BoundedSemaphore(64)
    if mode == "sinkhole":
        certs.ctx("sandbox.invalid")
        certs_default = (os.path.join(d, "certs", "sandbox.invalid.crt"), os.path.join(d, "certs", "sandbox.invalid.key"))
        for t, port in tcp:
            threading.Thread(target=sinkhole, args=(t, port, port == 443, log, names, token, certs, slots, answers), daemon=True).start()
    resolver(udp, log, names, mode == "sinkhole")


certs_default = None

if __name__ == "__main__":
    main()
