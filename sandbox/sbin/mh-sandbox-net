#!/usr/bin/python3 -I
# The sandbox's network, inside the VM: a resolver and a sinkhole. Nothing
# leaves the VM; what the code meant to reach is written down.
#
#   mh-sandbox-net DIR sinkhole|answers USER|servfail < TOKEN
#
# The code is the package mhnet (sandbox/net, in the image under LIB), what
# it does in mhnet/main.py. -I: no PYTHON* variable, no user's site, no
# script directory on the path; LIB and the system's only, both root's.
import sys

LIB = "/usr/lib/mh-sandbox/net"
sys.path.insert(0, LIB)

from mhnet.main import main  # noqa: E402

if __name__ == "__main__":
    main(sys.argv)
